# Copy this file to .env and fill in your own Volkswagen credentials.
# sandbox/.env is ignored by git.
VW_USERNAME=your-email@example.com
VW_PASSWORD=your-password
VW_COUNTRY=DK

# Required for the MBB vehicle-level probe. The MBB bearer cannot enumerate
# the account garage, so the VIN must be supplied directly.
VW_VIN=YOUR17CHARACTERVIN

# Optional. Useful when testing authentication changes.
VW_FAKE_USER_AGENT=false
